diff --git a/pkg/github/__toolsnaps__/list_repository_files.snap b/pkg/github/__toolsnaps__/list_repository_files.snap
new file mode 100644
index 0000000..7f95f08
--- /dev/null
+++ b/pkg/github/__toolsnaps__/list_repository_files.snap
@@ -0,0 +1,86 @@
+{
+  "annotations": {
+    "idempotentHint": false,
+    "readOnlyHint": true,
+    "title": "List repository files"
+  },
+  "description": "List all files in a repository, including subdirectories, with their sizes in bytes. Use it instead of listing directories one by one. Narrow large repositories with path.",
+  "inputSchema": {
+    "properties": {
+      "max_entries": {
+        "description": "Maximum number of files to return (default 1000, at most 5000)",
+        "maximum": 5000,
+        "minimum": 1,
+        "type": "integer"
+      },
+      "owner": {
+        "description": "Repository owner",
+        "type": "string"
+      },
+      "path": {
+        "description": "Only list files under this directory",
+        "type": "string"
+      },
+      "ref": {
+        "description": "Branch, tag or commit SHA (defaults to the default branch)",
+        "type": "string"
+      },
+      "repo": {
+        "description": "Repository name",
+        "type": "string"
+      }
+    },
+    "required": [
+      "owner",
+      "repo"
+    ],
+    "type": "object"

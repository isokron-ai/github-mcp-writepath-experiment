{
  "annotations": {
    "idempotentHint": false,
    "readOnlyHint": true,
    "title": "List repository files"
  },
  "description": "List all files in a repository, including subdirectories, with their sizes in bytes. Use it instead of listing directories one by one. Narrow large repositories with path.",
  "inputSchema": {
    "properties": {
      "max_entries": {
        "description": "Maximum number of files to return (default 1000, at most 5000)",
        "maximum": 5000,
        "minimum": 1,
        "type": "integer"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "path": {
        "description": "Only list files under this directory",
        "type": "string"
      },
      "ref": {
        "description": "Branch, tag or commit SHA (defaults to the default branch)",
        "type": "string"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo"
    ],
    "type": "object"
  },
  "name": "list_repository_files",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "files": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "size": {
              "type": "integer"
            }
          },
          "required": [
            "path",
            "size"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "path": {
        "type": "string"
      },
      "ref": {
        "type": "string"
      },
      "total": {
        "type": "integer"
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "required": [
      "ref",
      "total",
      "truncated",
      "files"
    ],
    "type": "object"
  }
}